<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="Reservar hospedagem"
             BackgroundColor="#F4F7F5">
    <ScrollView>
        <VerticalStackLayout Padding="22,28" Spacing="18">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Spacing="2">
                    <Label Text="HOTEL ACONCHEGO" FontSize="13" FontAttributes="Bold" TextColor="#B28A50" HorizontalTextAlignment="Start" />
                    <Label Text="Sua estadia começa aqui" FontSize="25" FontAttributes="Bold" TextColor="#173B32" HorizontalTextAlignment="Start" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Sobre" Clicked="Sobre_Clicked" BackgroundColor="#173B32" TextColor="White" CornerRadius="18" Padding="18,9" VerticalOptions="Center" />
            </Grid>

            <Border BackgroundColor="#173B32" StrokeThickness="0" Padding="20" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="6">
                    <Label Text="PLANEJE SUA VIAGEM" FontSize="12" FontAttributes="Bold" TextColor="#E7C995" HorizontalTextAlignment="Start" />
                    <Label Text="Encontre o espaço ideal para descansar." FontSize="21" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Start" />
                    <Label Text="Preencha os dados abaixo para calcular o valor da sua hospedagem." FontSize="13" TextColor="#E5ECE8" HorizontalTextAlignment="Start" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Stroke="#E2E9E4" StrokeThickness="1" Padding="18" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Hóspedes" FontSize="18" FontAttributes="Bold" TextColor="#173B32" HorizontalTextAlignment="Start" />
                    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <Label Text="Adultos" Grid.Row="0" VerticalOptions="Center" HorizontalTextAlignment="Start" TextColor="#34483F" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Value, Source={x:Reference stp_adultos}}" TextColor="#B28A50" FontAttributes="Bold" />
                        <Stepper x:Name="stp_adultos" Grid.Row="0" Grid.Column="2" Minimum="1" Maximum="10" Value="1" Increment="1" />
                        <Label Text="Crianças" Grid.Row="1" VerticalOptions="Center" HorizontalTextAlignment="Start" TextColor="#34483F" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Value, Source={x:Reference stp_criancas}}" TextColor="#B28A50" FontAttributes="Bold" />
                        <Stepper x:Name="stp_criancas" Grid.Row="1" Grid.Column="2" Minimum="0" Maximum="10" Value="0" Increment="1" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#E8EDE9" />
                    <Label Text="Acomodação" FontSize="18" FontAttributes="Bold" TextColor="#173B32" HorizontalTextAlignment="Start" />
                    <Picker x:Name="pck_quarto" Title="Selecione sua suíte" ItemDisplayBinding="{Binding Descricao}" TextColor="#34483F" BackgroundColor="#F4F7F5" />
                    <Label Text="Período da estadia" FontSize="18" FontAttributes="Bold" TextColor="#173B32" HorizontalTextAlignment="Start" />
                    <Label Text="Check-in" FontSize="13" TextColor="#66766D" HorizontalTextAlignment="Start" />
                    <DatePicker x:Name="dtpck_checkin" DateSelected="dtpck_checkin_DateSelected" Format="dd/MM/yyyy" TextColor="#173B32" />
                    <Label Text="Check-out" FontSize="13" TextColor="#66766D" HorizontalTextAlignment="Start" />
                    <DatePicker x:Name="dtpck_checkout" Format="dd/MM/yyyy" TextColor="#173B32" />
                    <Button Text="Calcular hospedagem" Clicked="Button_Clicked" BackgroundColor="#B28A50" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="52" />
                </VerticalStackLayout>
            </Border>
            <Label Text="Conforto, tranquilidade e bons momentos." FontSize="12" TextColor="#718078" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

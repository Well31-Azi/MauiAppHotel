<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="Resumo da hospedagem"
             BackgroundColor="#F4F7F5">
    <ScrollView>
        <VerticalStackLayout Padding="22,30" Spacing="18">
            <Label Text="RESERVA SIMULADA" FontSize="12" FontAttributes="Bold" TextColor="#B28A50" HorizontalTextAlignment="Start" />
            <Label Text="Resumo da hospedagem" FontSize="26" FontAttributes="Bold" TextColor="#173B32" HorizontalTextAlignment="Start" />
            <Border BackgroundColor="White" Stroke="#E2E9E4" StrokeThickness="1" Padding="20" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{Binding QuartoSelecionado.Descricao}" FontSize="22" FontAttributes="Bold" TextColor="#173B32" HorizontalTextAlignment="Start" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="12">
                        <VerticalStackLayout>
                            <Label Text="Adultos" FontSize="12" TextColor="#718078" HorizontalTextAlignment="Start" />
                            <Label Text="{Binding QntAdultos}" FontSize="18" FontAttributes="Bold" TextColor="#173B32" HorizontalTextAlignment="Start" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Crianças" FontSize="12" TextColor="#718078" HorizontalTextAlignment="Start" />
                            <Label Text="{Binding QntCriancas}" FontSize="18" FontAttributes="Bold" TextColor="#173B32" HorizontalTextAlignment="Start" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1">
                            <Label Text="Check-in" FontSize="12" TextColor="#718078" HorizontalTextAlignment="Start" />
                            <Label Text="{Binding DataCheckIn, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="16" FontAttributes="Bold" TextColor="#173B32" HorizontalTextAlignment="Start" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                            <Label Text="Check-out" FontSize="12" TextColor="#718078" HorizontalTextAlignment="Start" />
                            <Label Text="{Binding DataCheckOut, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="16" FontAttributes="Bold" TextColor="#173B32" HorizontalTextAlignment="Start" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#E8EDE9" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Duração da estadia" TextColor="#46574E" HorizontalTextAlignment="Start" />
                        <Label Grid.Column="1" Text="{Binding Estadia, StringFormat='{}{0} diária(s)'}" FontAttributes="Bold" TextColor="#173B32" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border BackgroundColor="#173B32" StrokeThickness="0" Padding="20" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="5">
                    <Label Text="VALOR TOTAL ESTIMADO" FontSize="12" FontAttributes="Bold" TextColor="#E7C995" HorizontalTextAlignment="Start" />
                    <Label Text="{Binding ValorTotal, StringFormat='{}{0:C}'}" FontSize="30" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Start" />
                </VerticalStackLayout>
            </Border>
            <Button Text="Voltar e editar" Clicked="Button_Clicked" BackgroundColor="#B28A50" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="52" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

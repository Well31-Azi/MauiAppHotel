<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="Confirmação da hospedagem"
             BackgroundColor="#F4F7F5">

    <ScrollView>
        <VerticalStackLayout Padding="22,30" Spacing="20">

            <VerticalStackLayout HorizontalOptions="Center"
                                 Spacing="8">

                <Border BackgroundColor="#173B32"
                        StrokeThickness="0"
                        WidthRequest="75"
                        HeightRequest="75"
                        StrokeShape="RoundRectangle 40">

                    <Label Text="✓"
                           FontSize="42"
                           TextColor="#E7C995"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                </Border>

                <Label Text="RESERVA SIMULADA"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#B28A50"
                       HorizontalTextAlignment="Center"/>

                <Label Text="Reserva confirmada!"
                       FontSize="25"
                       FontAttributes="Bold"
                       TextColor="#173B32"
                       HorizontalTextAlignment="Center"/>

                <Label Text="Os dados da sua hospedagem estão abaixo."
                       FontSize="13"
                       TextColor="#718078"
                       HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>

            <Border BackgroundColor="White"
                    Stroke="#E2E9E4"
                    StrokeThickness="1"
                    Padding="20"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="16">

                    <Label Text="DADOS DA RESERVA"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#B28A50"/>

                    <Label Text="{Binding CodigoReserva}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#173B32"/>

                    <BoxView HeightRequest="1"
                             Color="#E8EDE9"/>

                    <Label Text="{Binding QuartoSelecionado.Descricao}"
                           FontSize="21"
                           FontAttributes="Bold"
                           TextColor="#173B32"/>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="15">

                        <VerticalStackLayout>
                            <Label Text="Adultos"
                                   FontSize="12"
                                   TextColor="#718078"/>

                            <Label Text="{Binding QntAdultos}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#173B32"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Crianças"
                                   FontSize="12"
                                   TextColor="#718078"/>

                            <Label Text="{Binding QntCriancas}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#173B32"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1">
                            <Label Text="Check-in"
                                   FontSize="12"
                                   TextColor="#718078"/>

                            <Label Text="{Binding DataCheckIn, StringFormat='{0:dd/MM/yyyy}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#173B32"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1"
                                             Grid.Column="1">

                            <Label Text="Check-out"
                                   FontSize="12"
                                   TextColor="#718078"/>

                            <Label Text="{Binding DataCheckOut, StringFormat='{0:dd/MM/yyyy}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#173B32"/>
                        </VerticalStackLayout>

                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="#E8EDE9"/>

                    <Grid ColumnDefinitions="*,Auto">

                        <Label Text="Quantidade de diárias"
                               TextColor="#46574E"/>

                        <Label Grid.Column="1"
                               Text="{Binding Estadia, StringFormat='{0} diária(s)'}"
                               FontAttributes="Bold"
                               TextColor="#173B32"/>

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <Border BackgroundColor="#173B32"
                    StrokeThickness="0"
                    Padding="20"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="7">

                    <Label Text="VALOR TOTAL ESTIMADO"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#E7C995"/>

                    <Label Text="{Binding ValorTotal, StringFormat='{0:C}'}"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="White"/>

                </VerticalStackLayout>

            </Border>

            <Button Text="Voltar ao início"
                    Clicked="Button_Clicked"
                    BackgroundColor="#B28A50"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="52"/>

            <Label Text="Obrigado por escolher o Hotel Aconchego!"
                   FontSize="12"
                   TextColor="#718078"
                   HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
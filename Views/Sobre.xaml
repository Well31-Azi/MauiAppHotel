<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             BackgroundColor="#F4F7F5">
    <ScrollView>
        <VerticalStackLayout Padding="26" Spacing="20" VerticalOptions="Center">
            <Border BackgroundColor="#173B32" StrokeThickness="0" Padding="28" StrokeShape="RoundRectangle 24">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Label Text="✦" FontSize="48" TextColor="#E7C995" />
                    <Label Text="HOTEL ACONCHEGO" FontSize="25" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Conforto para sua melhor experiência." FontSize="14" TextColor="#E5ECE8" />
                </VerticalStackLayout>
            </Border>
            <Label Text="Sobre o aplicativo" FontSize="23" FontAttributes="Bold" TextColor="#173B32" HorizontalTextAlignment="Start" />
            <Label Text="Este aplicativo foi desenvolvido para facilitar a simulação de hospedagens. Nele, é possível informar a quantidade de hóspedes, escolher uma acomodação e selecionar as datas de entrada e saída para consultar o valor total da estadia." FontSize="15" TextColor="#46574E" LineHeight="1.35" HorizontalTextAlignment="Start" />
            <Border BackgroundColor="White" Stroke="#E2E9E4" StrokeThickness="1" Padding="18" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Desenvolvedor" FontSize="13" TextColor="#718078" HorizontalTextAlignment="Start" />
                    <Label Text="Wellington Oliveira de Araújo" FontSize="17" FontAttributes="Bold" TextColor="#173B32" HorizontalTextAlignment="Start" />
                    <BoxView HeightRequest="1" Color="#E8EDE9" />
                    <Label Text="Ano de desenvolvimento" FontSize="13" TextColor="#718078" HorizontalTextAlignment="Start" />
                    <Label Text="2026" FontSize="17" FontAttributes="Bold" TextColor="#173B32" HorizontalTextAlignment="Start" />
                    <BoxView HeightRequest="1" Color="#E8EDE9" />
                    <Label Text="Tecnologia" FontSize="13" TextColor="#718078" HorizontalTextAlignment="Start" />
                    <Label Text=".NET MAUI • C#" FontSize="17" FontAttributes="Bold" TextColor="#173B32" HorizontalTextAlignment="Start" />
                </VerticalStackLayout>
            </Border>
            <Button Text="Voltar para a reserva" Clicked="Voltar_Clicked" BackgroundColor="#B28A50" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="52" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
